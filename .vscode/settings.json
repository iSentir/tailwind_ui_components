{
  "eslint.codeActionsOnSave.rules": null,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "diffEditor.experimental.showMoves": true,
  "diffEditor.experimental.useTrueInlineView": true,
  "diffEditor.codeLens": true,
  "editor.formatOnSave": true,
  "editor.formatOnType": true,
  "eslint.format.enable": true,
  "eslint.useESLintClass": true,
  "diffEditor.hideUnchangedRegions.contextLineCount": 1,
  "diffEditor.hideUnchangedRegions.minimumLineCount": 1,
  "vs-code-prettier-eslint.prettierLast": true,
  "prettier.trailingComma": "all",
  "prettier.documentSelectors": ["javascript", "html", "css", "scss"],
  "cSpell.userWords": ["пенсии"],
  "eslint.probe": ["astro", "javascript", "javascriptreact", "typescript", "typescriptreact", "html", "mdx", "vue", "markdown", "json", "jsonc", "react"],
  "workbench.activityBar.location": "top",
  "settingsSync.ignoredExtensions": [],
  "[python]": {
    "diffEditor.ignoreTrimWhitespace": false,
    "editor.defaultColorDecorators": "never"
  },
  "git.autofetch": true,
  "mssql.connectionGroups": [
    {
      "name": "ROOT",
      "id": "ROOT"
    }
  ],
  "git.enableSmartCommit": true,
  "pgsql.openQueryResultsInTabByDefaultDoNotShowPrompt": true,
  "prettier.printWidth": 160,
  "files.autoSave": "afterDelay",
  "liveServer.settings.mount": [],
  "window.menuBarVisibility": "classic",
  "workbench.settings.applyToAllProfiles": [],
  "git.confirmSync": false,
  "chat.disableAIFeatures": true,
  "editor.lineHeight": 22,
  "editor.fontFamily": "Consolas,'Courier New', monospace ",
  "explorer.compactFolders": false,
  "chat.agent.maxRequests": 120,
  "chat.agent.sandbox.fileSystem.linux": {
    "denyRead": [],
    "allowRead": [],
    "allowWrite": [],
    "denyWrite": []
  },
  "prettier.jsxSingleQuote": true,
  "editor.wordWrapColumn": 120,
  "editor.wrappingIndent": "indent",
  "editor.tabSize": 6,
  "html.format.wrapAttributesIndentSize": 120,
  "editor.wordWrap": "on",
  "css.format.spaceAroundSelectorSeparator": true,
  "scss.format.spaceAroundSelectorSeparator": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "prettier.embeddedLanguageFormatting": "off",
  "[scss]": {
    "editor.defaultFormatter": "vscode.css-language-features"
  },
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "prettier.singleQuote": true,
