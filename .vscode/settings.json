  "emmet.includeLanguages": {
    "nunjucks": "html",
    "javascript": "javascriptreact"
  },
  "emmet.triggerExpansionOnTab": true,
  "emmet.showSuggestionsAsSnippets": true,
  "svelte.enable-ts-plugin": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "css.hover.references": false,
  "liveServer.settings.donotShowInfoMsg": true,
  "workbench.editor.splitInGroupLayout": "vertical",
  "liveServer.settings.donotVerifyTags": true,
  "window.density.editorTabHeight": "compact",
  "editor.fontWeight": "300",
  "errorLens.fontWeight": "300",
  // "window.zoomLevel": 1,
  "search.exclude": {
    "**/node_modules": true,
    "**/venv": true
  },
  "window.density.layout": "compact",
  //------------------------------------------------------------------------------
  //      ТЕМА
  //------------------------------------------------------------------------------
  "workbench.colorTheme": "Dark Modern",
  "workbench.colorCustomizations": {
    // Заменяет background
    "editor.background": "#282C34",
    "sideBar.background": "#282C34",
    "activityBar.background": "#282C34"
  },
  "workbench.tree.indent": 14,
  "editor.tokenColorCustomizations": {
    "[Dark Modern]": {
      "textMateRules": [
        {
          "scope": "entity.other.attribute-name.pseudo-class.css",
          "settings": {
            "foreground": "#fff"
          }
        },
        {
          "scope": "entity.other.attribute-name.pseudo-element.css",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    }
  },
  "[css]": {
    "editor.fontWeight": "300" // толщина шрифта
  },
  //------------------------------------------------------------------------------
  //      ТЕМА            END
  //------------------------------------------------------------------------------
  "chat.agent.enabled": false,
  "chat.agent.collapseCompletedResponses": false,
  "chat.agent.sandbox.allowAutoApprove": false,
  "chat.agent.sandbox.allowNetwork": false,
  "chat.agent.sandbox.allowUnsandboxedCommands": false,
  "chat.agent.sandbox.retryWithAllowNetworkRequests": false,
  "chat.agent.codeBlockProgress": false,
  "chat.agent.thinking.generateTitles": false,
  "chat.agent.thinking.terminalTools": false,
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.enabled": false,
  "editor.letterSpacing": 0.3,
  "editor.fontSize": 13,
  "window.newWindowProfile": "jsnext052026"
}
